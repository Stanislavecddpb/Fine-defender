# --- База данных (Postgres, хостинг в РФ — 152-ФЗ) ---
DATABASE_URL=postgresql+psycopg://fine_defender:change_me@localhost:5432/fine_defender

# --- Шифрование токенов WB (envelope encryption) ---
# В проде это data-key из KMS/секрет-менеджера. Локально — Fernet-ключ (base64, 32 байта).
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Секрет подписи сессионной cookie кабинета (ОБЯЗАТЕЛЬНО свой в проде) ---
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# --- Прочее ---
LOG_LEVEL=INFO
# Путь к бизнес-конфигу (пороги, паттерны, расписание, формула дедлайна)
APP_CONFIG_PATH=config/config.yaml

# --- Боевые настройки ---
# Бэкенд API: postgres (бой) | memory (демо с засевом из фикстуры)
APP_BACKEND=postgres
# WB-клиент: live (реальный API) | mock (фикстура — демо без токена)
WB_CLIENT_MODE=live
# Фикстура для WB_CLIENT_MODE=mock
SAMPLE_REPORT_PATH=samples/weekly_report_demo.json
# Интервал фонового воркера (сек)
WORKER_INTERVAL_SECONDS=3600
# Автозасев демо-селлера в mock-режиме, если в БД пусто
DEMO_SEED=false

# ВНИМАНИЕ: сам WB API-токен в .env НЕ хранится — он шифруется и лежит в БД (sellers.wb_token_enc).
# Заводится скриптом scripts/seed_seller.py. Токен никогда не попадает в логи и в git.
